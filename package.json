    "@supabase/sentry-js-integration": "0.3.0",
    "@supabase/supabase-js": "2.93.2",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/query-async-storage-persister": "5.99.0",
    "@tanstack/react-query": "5.99.0",
    "@tanstack/react-query-devtools": "5.91.3",
    "@tanstack/react-query-persist-client": "5.99.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "common-tags": "1.8.2",
    "compressorjs": "1.2.1",
    "date-fns": "3.2.0",
    "eslint": "9.39.2",
    "i18next": "25.5.2",
    "i18next-browser-languagedetector": "8.2.0",
    "leaflet": "1.9.4",
    "leaflet-geosearch": "4.2.2",
    "lodash.differencewith": "4.5.0",
    "lodash.groupby": "4.6.0",
    "lodash.isequal": "4.5.0",
    "lodash.topairs": "4.3.0",
    "lucide-react": "1.7.0",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.0.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.0.0",
    "react-easy-crop": "5.5.6",
    "react-hook-form": "7.72.1",
    "react-i18next": "15.7.3",
    "react-leaflet": "5.0.0",
    "react-qr-code": "2.0.18",
    "react-router": "7.12.0",
    "shadcn": "4.1.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2",
    "use-local-storage-state": "^19.5.0",
    "uuid": "13.0.0",
    "workbox-build": "7.3.0",
    "workbox-window": "7.3.0"
  },
  "scripts": {
    "start": "vite",
    "start:rk:prod": "vite --mode karlsruhe --host",
    "start:mrc:prod": "vite --mode munich",
    "start:staging": "vite --mode staging",
    "test": "vitest",
    "build": "vite build",
    "preview": "vite preview",
    "build:karlsruhe": "vite build --mode karlsruhe",
    "build:karlsruhe-stg": "vite build --mode staging",
    "build:munich": "vite build --mode munich",
    "analyze": "vite build --mode analyze",
    "gen-types:production": "dotenv -e environments/.env.production.local -e environments/.env.karlsruhe.local -- npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public,games,audit,notifications,util > src/types/supabase-generated.types.ts",
    "gen-types:staging": "dotenv -e environments/.env.staging.local -- npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public,games,audit,notifications,util > src/types/supabase-generated.types.ts",
    "gen-types:local": "npx supabase gen types typescript --local --schema public,games,audit,notifications,util > src/types/supabase-generated.types.ts && cp src/types/supabase-generated.types.ts supabase/functions/_shared",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\" --config ./.prettierrc.json",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org roundnet-karlsruhe --project roundnet-karlsruhe ./build && sentry-cli sourcemaps upload --org roundnet-karlsruhe --project roundnet-karlsruhe ./build",
    "gen-types:custom": "vite-node scripts/generate-types.ts",
    "supabase:db:push:staging": "dotenv -e environments/.env.staging.local -- supabase link --project-ref \"$SUPABASE_PROJECT_ID\" && supabase db push --linked",
    "supabase:db:push:rk:prod": "dotenv -e environments/.env.production.local -e environments/.env.karlsruhe.local -- supabase link --project-ref \"$SUPABASE_PROJECT_ID\" && supabase db push",
    "supabase:db:push:mrc:prod": "dotenv -e environments/.env.production.local -e environments/.env.munich.local -- supabase link --project-ref \"$SUPABASE_PROJECT_ID\" && supabase db push",
    "supabase:db:push:prod": "yarn supabase:db:push:rk:prod && yarn supabase:db:push:mrc:prod",
    "supabase:func:deploy:prod": "dotenv -e environments/.env.production.local -e environments/.env.munich.local -- supabase functions deploy --project-ref \"$VITE_SUPABASE_PROJECT_ID\" && dotenv -e environments/.env.production.local -e environments/.env.karlsruhe.local -- supabase functions deploy --project-ref \"$VITE_SUPABASE_PROJECT_ID\"",
    "supabase:func:deploy:stag": "dotenv -e environments/.env.staging.local -- supabase functions deploy --project-ref \"$VITE_SUPABASE_PROJECT_ID\"",
    "playwright:install-deps": "npx playwright install-deps || true",
    "playwright:install-browsers": "npx playwright install",
    "test:e2e": "dotenv -e environments/.env.local -- playwright test e2e/playwright"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@eslint-react/eslint-plugin": "2.3.10",
    "@playwright/test": "^1.59.1",
    "@tanstack/eslint-plugin-query": "5.91.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/leaflet": "1.9.7",
    "@types/lodash.differencewith": "4.5.9",
    "@types/lodash.groupby": "4.6.9",
    "@types/lodash.isequal": "4.5.8",
    "@types/lodash.topairs": "4.3.9",
    "@types/node": "24.5.2",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/selenium-webdriver": "4.35.5",
    "@vitejs/plugin-react": "5.0.3",
    "baseline-browser-mapping": "2.10.16",
    "chromedriver": "144.0.0",
    "dotenv-cli": "10.0.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "jest": "30.2.0",
    "jsdom": "27.2.0",
    "msw": "2.12.3",
    "playwright": "^1.59.1",
    "prettier": "3.4.2",
    "rollup-plugin-visualizer": "6.0.5",
    "selenium-webdriver": "4.40.0",
    "supabase": "2.20.5",
    "ts-jest": "29.4.6",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.1",
    "vite-node": "3.2.4",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "4.0.14"
  }
}
