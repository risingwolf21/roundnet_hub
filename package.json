{
  "name": "roundnet_karlsruhe_app",
  "version": "1.6.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@casl/ability": "^6.5.0",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/base": "^5.0.0-beta.33",
    "@mui/icons-material": "^5.10.9",
    "@mui/material": "^6.1.8",
    "@mui/x-data-grid": "7.19.0",
    "@mui/x-date-pickers": "^6.11.2",
    "@reduxjs/toolkit": "^1.9.5",
    "@sentry/cli": "^2.45.0",
    "@sentry/react": "^9.17.0",
    "@supabase/sentry-js-integration": "^0.3.0",
    "@supabase/supabase-js": "^2.43.4",
    "@tanstack/react-query": "^5.77.2",
    "@toolpad/core": "^0.13.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^22.14.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "compressorjs": "^1.2.1",
    "date-fns": "^3.0.5",
    "dayjs": "^1.11.10",
    "env-cmd": "^10.1.0",
    "firebase": "^10.11.0",
    "i18next": "^23.4.6",
    "i18next-browser-languagedetector": "^7.1.0",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^3.9.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-easy-crop": "^5.0.0",
    "react-ga4": "^2.1.0",
    "react-i18next": "^13.2.0",
    "react-leaflet": "^4.2.1",
    "react-router": "^7.2.0",
    "react-scripts": "^5.0.1",
    "react-supabase": "^0.2.0",
    "react-toastify": "^10.0.5",
    "reflect-metadata": "^0.1.13",
    "typescript": "^5.8.3",
    "uuid": "^11.0.5"
  },
  "scripts": {
    "start": "env-cmd -e main,development react-scripts start",
    "start:rk:prod": "env-cmd -e main,roundnet-karlsruhe,production react-scripts start",
    "start:mrc:prod": "env-cmd -e main,munich-roundnet,production react-scripts start",
    "build:staging": "env-cmd -e main,staging react-scripts build",
    "build:production": "env-cmd -e main,production react-scripts build",
    "deploy-functions:production": "npx supabase functions deploy --project-ref PROJECT_REF",
    "gen-types:production": "npx supabase gen types typescript --project-id PROJECT_REF --schema public --schema games --schema permissions > src/types/supabase-generated.types.ts",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\" --config ./.prettierrc.json",
    "knip": "knip",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org roundnet-karlsruhe --project roundnet-karlsruhe ./build && sentry-cli sourcemaps upload --org roundnet-karlsruhe --project roundnet-karlsruhe ./build",
    "generate:supabase-types": "env-cmd -e roundnet-karlsruhe ts-node scripts/generate-types.ts",
    "generate:supabase-types:production": "ts-node scripts/generate-types.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "ignorePatterns": [
      "src/types/supabase.ts"
    ],
    "rules": {
      "no-restricted-imports": [
        "error",
        {
          "patterns": [
            "@mui/*/*/*"
          ]
        }
      ]
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@tanstack/eslint-plugin-query": "^5.74.7",
    "@types/leaflet": "^1.9.7",
    "@types/lodash": "^4.17.13",
    "knip": "^5.50.5",
    "prettier": "^3.4.2",
    "supabase": "^2.20.5",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "@supabase/supabase-js": {
      "@supabase/gotrue-js": "2.61.0"
    }
  }
}
