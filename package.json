  "scripts": {
    "start": "env-cmd -e main,development react-scripts start",
    "start:staging": "env-cmd -e main,staging react-scripts start",
    "start:production": "env-cmd -e main,production react-scripts start",
    "start:production_admin": "env-cmd -e main,production,admin react-scripts start",
    "build:staging": "env-cmd -e main,staging react-scripts build",
    "build:production": "env-cmd -e main,production react-scripts build",
    "build:production:admin": "env-cmd -e main,production,admin react-scripts build",
    "deploy-functions:production": "npx supabase functions deploy --project-ref PROJECT_REF",
    "gen-types:production": "npx supabase gen types typescript --project-id PROJECT_REF --schema public --schema games --schema permissions > src/types/supabase-generated.types.ts",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\" --config ./.prettierrc.json"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "ignorePatterns": [
      "src/types/supabase.ts"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
