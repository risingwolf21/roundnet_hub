 "cards": [
  {
   "dot": "rose",
   "title": "Who checks the token",
   "items": [
    "Supabase Auth issues the JWT; PostgREST validates it on every request.",
    "Postgres decides what is visible: RLS policies use auth.uid(), permissions use authorize(key) over user_grants_view."
   ]
  },
  {
   "dot": "cyan",
   "title": "Client side",
   "items": [
    "The route guard and feature gates are convenience only.",
    "Realtime channels refetch the grants when a grant or membership changes."
   ]
  }
 ]
