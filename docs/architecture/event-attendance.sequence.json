 "cards": [
  {
   "dot": "emerald",
   "title": "Where the rules live",
   "items": [
    "Capacity, waitlist and trial seats are decided in update_attendance and its triggers, not in the client.",
    "An advisory lock per event stops two parallel signups from overbooking."
   ]
  },
  {
   "dot": "orange",
   "title": "Async part",
   "items": [
    "The push is not sent in the request: pg_cron checks the outbox every minute and calls push-worker through pg_net."
   ]
  }
 ]
