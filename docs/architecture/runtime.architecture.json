  "cards": [
    { "dot": "cyan", "title": "Clients", "items": [
      "One React build per tenant (Karlsruhe, Munich, staging), served by Firebase Hosting.",
      "The service worker shows web pushes; the push service delivers them to the browser.",
      "Calendar apps poll the per-user ical feed edge function."
    ] },
    { "dot": "emerald", "title": "Supabase", "items": [
      "The SPA talks to PostgREST directly; business rules live in RLS policies, RPCs and triggers.",
      "pg_cron runs push_worker_quick (every minute), event transformations (hourly), series expansion, trial expiry and cache purge.",
      "Realtime pushes grant changes so the client refetches its permissions (src/features/auth/tanstack/useUserGrantsQuery.tsx)."
    ] },
    { "dot": "rose", "title": "Security", "items": [
      "Every request carries the user JWT; Postgres checks it with auth.uid(), RLS and authorize(permission).",
      "Edge functions that act as admin re-check permissions via rpc authorize before using the service role.",
      "pg_net reads EDGE_BASE_URL and EDGE_BEARER from Vault to call workers."
    ] },
    { "dot": "amber", "title": "Deploy", "items": [
      "GitHub Actions (production.yml): db test + e2e gate, then supabase db push, functions deploy and Firebase deploy per tenant.",
      "Edge functions and database triggers also report errors to Sentry (sentry-report)."
    ] }
  ]
